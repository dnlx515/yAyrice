configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "Search";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    font: "CaskaydiaCove Nerd Font 11";
}

* {
    background: #131318A6;
    background-alt: #1f1f25CC;
    foreground: #e4e1e9;
    muted: #c8c5d0;
    accent: #c1c1ff;
    accent-soft: #404178CC;
    border: #c1c1ff99;
    urgent: #918f9a;

    selected-normal-background: @accent-soft;
    selected-normal-foreground: @foreground;
    selected-active-background: @accent-soft;
    selected-active-foreground: @foreground;
    selected-urgent-background: @accent-soft;
    selected-urgent-foreground: @foreground;
    urgent-foreground: @foreground;
}

window {
    width: 620px;
    border: 2px;
    border-color: @border;
    border-radius: 20px;
    background-color: @background;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border: 1px;
    border-color: #FFFFFF18;
    border-radius: 14px;
    padding: 12px 14px;
    spacing: 10px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: @foreground;
    placeholder-color: @muted;
    background-color: transparent;
    cursor: text;
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    scrollbar: true;
    dynamic: true;
    fixed-height: false;
    background-color: transparent;
}

scrollbar {
    handle-width: 6px;
    handle-color: @accent;
    border-radius: 8px;
    background-color: #FFFFFF12;
}

element {
    orientation: horizontal;
    padding: 10px 12px;
    border-radius: 13px;
    spacing: 12px;
    background-color: transparent;
}

element normal {
    text-color: @foreground;
    background-color: transparent;
}

element alternate {
    text-color: @foreground;
    background-color: transparent;
}

element selected {
    text-color: @foreground;
    background-color: @accent-soft;
    border: 1px;
    border-color: #c1c1ff70;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}

element-icon {
    size: 30px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @accent-soft;
    text-color: @foreground;
}
