* {
    font: "CaskaydiaCove Nerd Font 11";
    background: {{colors.surface.default.hex}}A6;
    background-alt: {{colors.surface_container.default.hex}}CC;
    foreground: {{colors.on_surface.default.hex}};
    muted: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-soft: {{colors.primary_container.default.hex}}CC;
    border: {{colors.primary.default.hex}}99;
    urgent: {{colors.outline.default.hex}};

    selected-normal-background: @accent-soft;
    selected-normal-foreground: @foreground;
    selected-active-background: @accent-soft;
    selected-active-foreground: @foreground;
    selected-urgent-background: @accent-soft;
    selected-urgent-foreground: @foreground;
    urgent-foreground: @foreground;
}

window {
    width: 480px;
    border: 2px;
    border-color: @border;
    border-radius: 20px;
    background-color: @background;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border: 1px;
    border-color: #FFFFFF18;
    border-radius: 14px;
    padding: 12px 14px;
    spacing: 10px;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    text-color: @foreground;
    placeholder-color: @muted;
    background-color: transparent;
    cursor: text;
}

listview {
    columns: 1;
    lines: 4;
    spacing: 6px;
    scrollbar: false;
    dynamic: true;
    fixed-height: false;
    background-color: transparent;
}

element {
    orientation: horizontal;
    padding: 10px 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 13px;
    spacing: 12px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @accent-soft;
    text-color: @foreground;
    border: 1px;
    border-color: {{colors.primary.default.hex}}70;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    background-color: transparent;
}

element-icon {
    size: 30px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @accent-soft;
    text-color: @foreground;
}
