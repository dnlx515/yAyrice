{
  "layer": "top",
  "position": "top",
  "height": 25,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 14,
  "margin-right": 14,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["tray", "pulseaudio", "cpu", "memory", "clock"],

  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": 5
    },
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "",
      "empty": ""
    },
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 45
  },


  "tray": {
    "icon-size": 17,
    "spacing": 8
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟  muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "MEM {}%"
  },


  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  }
}
